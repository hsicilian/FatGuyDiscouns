{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@fatguydiscounts/types": ["packages/types/src/index.ts"],
      "@fatguydiscounts/core": ["packages/core/src/index.ts"],
      "@fatguydiscounts/db": ["packages/db/src/index.ts"],
      "@fatguydiscounts/ui": ["packages/ui/src/index.ts"],
      "@supabase/ssr": ["types/supabase-ssr.d.ts"],
      "@supabase/supabase-js": ["types/supabase-supabase-js.d.ts"]
    }
  }
}

